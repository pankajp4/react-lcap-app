{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@src/*": ["*"],
      "@components/*": ["components/*"],
      "@atoms": ["components/atoms/index.ts"],
      "@atoms/*": ["components/atoms/*"],
      "@molecules": ["components/molecules/index.ts"],
      "@molecules/*": ["components/molecules/*"],
      "@organisms": ["components/organisms/index.ts"],
      "@organisms/*": ["components/organisms/*"],
      "@templates/*": ["components/templates/*"],
      "@pages/*": ["pages/*"],
      "@store/*": ["store/*"],
      "@/types/*": ["types/*"],
      "@utils/*": ["utils/*"],
      "@config/*": ["config/*"],
      "@services/*": ["services/*"],
      "@styles/*": ["styles/*"],
      "@assets/*": ["assets/*"],
      "@test/*": ["test/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
